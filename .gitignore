# Bu depo GitHub Pages ile YAYINDA — içine giren her şey herkese açık olur.
#
# Yerel geliştirme sunucusu (iphone_server.py / teleprompter_server.py) HTTPS
# için kendinden imzalı sertifika kullanıyor. Kamera ve mikrofon izinleri
# yalnız güvenli bağlamda veriliyor, o yüzden sertifika gerekli — ama özel
# anahtar asla depoya girmemeli. Geçmişte girmemiş (kontrol edildi), bundan
# sonra da giremesin diye burada.
*.pem
*.key
*.p12
*.pfx

# İşletim sistemi artıkları
.DS_Store

# Mağaza kareleri: taslaklar HER koşuda yeniden üretiliyor (sahte kamera).
# İkili dosya oldukları için geçmişi şişirirler; mağazaya hazır olanlar
# depoda durur, taslaklar `python3 ekran.py` ile bir komutta geri gelir.
magaza/ekranlar/*.taslak.png
